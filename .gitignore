# Track only reviewed project files; device backups and raw logs stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/installer/
/installer/__pycache__/
!/work/
!/outputs/
/work/*
!/work/build_russian_pilot.py
!/work/build_uniform_fonts.py
!/work/test_uniform_fonts.py
!/work/pack_uniform_pilot.cjs
!/work/flash_russian_pilot.py
!/work/pack_pilot.cjs
!/work/patch_embedded_fonts.py
!/work/test_embedded_fonts.py
!/work/verify_russian_pilot.py
!/work/xreal_usb_probe.py
!/work/translations-ru.json
!/work/update-analysis/
/work/update-analysis/*
!/work/update-analysis/font-raster-analysis.json
/outputs/*
!/outputs/xreal-russian-translation/
/outputs/xreal-russian-translation/*
!/outputs/xreal-russian-translation/osd_language_ru_draft.csv
!/outputs/xreal-russian-translation/XREAL_русский_перевод.xlsx
!/outputs/xreal-russian-firmware/
/outputs/xreal-russian-firmware/*
!/outputs/xreal-russian-firmware/README.txt
!/outputs/xreal-russian-firmware/font-preview.png
!/outputs/xreal-russian-firmware/package-manifest.json
!/outputs/xreal-russian-firmware/build-validation.json
!/outputs/xreal-russian-firmware/embedded-font-validation.json
!/outputs/xreal-russian-firmware/installed-verification.json
!/outputs/xreal-russian-firmware/runtime-font-verification.json
!/outputs/xreal-russian-firmware/XREAL_One_Pro_Pilot_RU.bin
